FROM --platform=$BUILDPLATFORM golang:1.26.6-alpine@sha256:af8d6740070b8906d12eae1c3e3ea0957fb63f492051ea05e354c38ef9fe88df AS build
ARG BUILDPLATFORM
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY health.go .
RUN set -eu; echo "native builder=${BUILDPLATFORM} target=${TARGETOS}/${TARGETARCH}"; GOOS="${TARGETOS:-$(go env GOOS)}" GOARCH="${TARGETARCH:-$(go env GOARCH)}" CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /health-probe health.go

# Build the configured collector from the pinned upstream release with a
# patched Go stdlib and x/mod. The published collector image still contains
# both vulnerable components, so it cannot be used as the runtime base.
FROM --platform=$BUILDPLATFORM golang:1.26.6-bookworm@sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36 AS upstream-build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
RUN git clone --depth 1 --branch v0.159.0 https://github.com/open-telemetry/opentelemetry-collector-contrib.git . \
 && test "$(git rev-parse HEAD)" = 1120cc0714bf4d14600105e5673c3b00fe87467a \
 && go install go.opentelemetry.io/collector/cmd/builder@v0.159.0 \
 && ./internal/buildscripts/ocb-add-replaces.sh otelcontribcol \
 && /go/bin/builder --skip-compilation --config cmd/otelcontribcol/builder-config-replaced.yaml
WORKDIR /src/cmd/otelcontribcol
RUN go mod edit -require=golang.org/x/mod@v0.40.0 \
 && go mod tidy \
 && CGO_ENABLED=0 GOOS="${TARGETOS:-$(go env GOOS)}" GOARCH="${TARGETARCH:-$(go env GOARCH)}" go build -trimpath -o /otelcol-contrib -tags '' .

FROM scratch
COPY --from=build /health-probe /health-probe
COPY --from=upstream-build /otelcol-contrib /otelcol-contrib
USER 10001:10001
ENTRYPOINT ["/otelcol-contrib"]
HEALTHCHECK --interval=5s --timeout=3s --retries=20 CMD ["/health-probe","-url","http://127.0.0.1:13133/"]
