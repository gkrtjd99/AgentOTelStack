{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gateway query envelope v1",
  "type": "object",
  "required": ["schema_version", "data", "partial", "truncated", "content_trust", "backends"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"enum": ["gateway.services.v1", "gateway.context.v1", "gateway.errors.v1", "gateway.correlate.v1"]},
    "freshness": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "properties": {
        "project": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "service": {"type": "string", "minLength": 1},
        "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "lookback": {"enum": ["5m", "15m", "1h", "6h", "24h"]},
        "limit": {"type": "integer", "minimum": 1, "maximum": 500}
      },
      "additionalProperties": false
    },
    "data": {},
    "partial": {"type": "boolean"},
    "truncated": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "content_trust": {"const": "untrusted_telemetry"},
    "backends": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string"},
          "status": {"type": "string"},
          "error": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
