# Secrets, credentials, and local environment (keep safe examples tracked)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.keystore
*.jks
secrets/
credentials/
**/credentials/
.aws/
.kube/
id_rsa
id_rsa.pub
id_ed25519

# AgentOTel project-local runtime state; project.toml is the committed identity
.agentotel/project.toml.tmp.*
.agentotel/checkout_id
.agentotel/checkout_id.tmp.*
.agentotel/current
.agentotel/previous
.agentotel/run/
.agentotel/runs/
.agentotel/token*
.agentotel/state/
.agentotel/*.state
.agentotel/*.log

# OS/editor/IDE clutter
.DS_Store
.DS_Store?
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
desktop.ini
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*.swn
*.orig
*.rej
*~
.project
.settings/
.history/
.claude/settings.local.json
.codex/

# Node dependencies, package-manager caches/logs, and test artifacts
**/node_modules/
.cache/
**/.cache/
.eslintcache
.stylelintcache
.nyc_output/
*.tsbuildinfo
.npm/
.yarn/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
**/e2e/test-results/
**/e2e/playwright-report/
**/playwright-report/
**/playwright-artifacts/
**/test-results/

# Python/test caches (only generated caches, never source or lockfiles)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
.python-version

# Trivy vulnerability database and filesystem analysis cache
.trivy-cache/

# CI-generated reports (security waivers remain tracked under security/)
/artifacts/

# Go build/test output. Keep *.go, go.mod, go.sum, and tests visible.
gateway/bin/
mcp/bin/
backend-health/bin/
mcp/mcp
gateway/coverage/
mcp/coverage/
backend-health/coverage/
gateway/*.out
mcp/*.out
backend-health/*.out
gateway/*.prof
mcp/*.prof
backend-health/*.prof
gateway/*.test
mcp/*.test
backend-health/*.test
*.exe
*.exe~
*.dll
*.so
*.dylib

# AgentOTel generated/install artifacts (do not ignore source bin/obs)
/bin/agentotel-mcp
/bin/agentotel-mcp-*
/bin/*.linux-*
/bin/*.darwin-*
/bin/*.windows-*
*.install.tmp.*
.install.tmp.*
**/current.tmp.*
**/previous.tmp.*
**/manifest.sha256.tmp.*

# Local Compose/test outputs; committed compose/config files remain visible
docker-compose.override.yml
docker-compose.local.yml
docker-compose.generated.yml
.docker-compose.env
.compose.env
.compose-project/
.compose-state/
compose-*.log
test-output/
test-results/

# Logs, temporary output, and coverage reports (scoped generated locations)
logs/
tmp/
coverage/
*.log
*.tmp
*.coverage
*.coverprofile

# Document QA/backup artifacts; final docs and docs/ remain trackable
~$*.docx
*.docx~
*.docx.bak
*.docx.tmp
*.docx.lock
docx-render/
docx-rendered/
rendered-pages/
qa-render/
*.page.png
*.page.pdf
