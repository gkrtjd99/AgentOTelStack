# Secrets, credentials, and local environment (keep safe examples tracked)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.keystore
*.jks
secrets/
credentials/
**/credentials/
.aws/
.kube/
id_rsa
id_rsa.pub
id_ed25519

# AgentOTel project-local metadata and runtime state (generated locally)
.agentotel/

# OS/editor/IDE clutter
.DS_Store
.DS_Store?
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
desktop.ini
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*.swn
*.orig
*.rej
*~
.project
.settings/
.history/
.claude/settings.local.json
.codex/

# Node dependencies, package-manager caches/logs, and test artifacts
**/node_modules/
.cache/
**/.cache/
.eslintcache
.stylelintcache
.nyc_output/
*.tsbuildinfo
.npm/
.yarn/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
**/e2e/test-results/
**/e2e/playwright-report/
**/playwright-report/
**/playwright-artifacts/
**/test-results/

# Python/test caches (only generated caches, never source or lockfiles)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
.python-version

# Trivy vulnerability database and filesystem analysis cache
.trivy-cache/

# CI-generated reports (no vulnerability waivers; reports stay untracked)
/artifacts/
/dist/

# Go build/test output. Keep *.go, go.mod, go.sum, and tests visible.
# Dashboard builds to this local artifact path; it is never a source asset.
src/dashboard/dashboard
src/gateway/bin/
src/mcp/bin/
src/backend-health/bin/
src/mcp/mcp
src/gateway/coverage/
src/mcp/coverage/
src/backend-health/coverage/
src/gateway/*.out
src/mcp/*.out
src/backend-health/*.out
src/gateway/*.prof
src/mcp/*.prof
src/backend-health/*.prof
src/gateway/*.test
src/mcp/*.test
src/backend-health/*.test
*.exe
*.exe~
*.dll
*.so
*.dylib

# AgentOTel generated/install artifacts (do not ignore source bin/obs)
/bin/agentotel-mcp
/bin/agentotel-mcp-*
/bin/*.linux-*
/bin/*.darwin-*
/bin/*.windows-*
*.install.tmp.*
.install.tmp.*
**/current.tmp.*
**/previous.tmp.*
**/manifest.sha256.tmp.*

# Local Compose/test outputs; committed compose/config files remain visible
docker-compose.override.yml
docker-compose.local.yml
docker-compose.generated.yml
.docker-compose.env
.compose.env
.compose-project/
.compose-state/
compose-*.log
test-output/
test-results/

# Logs, temporary output, and coverage reports (scoped generated locations)
logs/
tmp/
coverage/
*.log
*.tmp
*.coverage
*.coverprofile

# Document QA/backup artifacts; final docs and docs/ remain trackable
~$*.docx
*.docx~
*.docx.bak
*.docx.tmp
*.docx.lock
docx-render/
docx-rendered/
rendered-pages/
qa-render/
*.page.png
*.page.pdf
